# Copy to apps/api/.env for development, or set these in the API host.
# Replace all placeholders; never commit real credentials.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?schema=public
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Optional: defaults to 4000; production hosts may supply PORT.
PORT=4000
# Comma-separated exact web origins; replace with HTTPS web origin in production.
CORS_ORIGINS=http://localhost:3000
